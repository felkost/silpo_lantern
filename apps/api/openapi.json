{
  "openapi": "3.1.0",
  "info": {
    "title": "Lantern API",
    "version": "0.1.0"
  },
  "paths": {
    "/session": {
      "post": {
        "summary": "Create Session",
        "operationId": "create_session_session_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateSessionResponse"
                }
              }
            }
          }
        }
      }
    },
    "/session/{session_id}/events": {
      "get": {
        "summary": "Session Events",
        "description": "Streams the session's already-recorded outcome as SSE events --\n`diagnosis`, `options`, `consent_required`, `receipt`, or `error`\n(plan section 1.5), each carrying `session_id`/`trace_id`/the version\ntuple. Deliberately a snapshot replay, not a live per-node push: the\ngraph's own read pipeline already completes synchronously inside\n`POST /session` (bounded by the plan's own 90s active-execution\nbudget), so there is no separate live progress to tail by the time a\nclient opens this connection.",
        "operationId": "session_events_session__session_id__events_get",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/session/{session_id}/consent": {
      "post": {
        "summary": "Submit Consent",
        "operationId": "submit_consent_session__session_id__consent_post",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConsentRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConsentResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/auth/start": {
      "get": {
        "summary": "Auth Start",
        "description": "The backend's own Silpo MCP OAuth (plan section 1.2) is a\nbackend-to-server credential, obtained today by the one-time\nphone+OTP script (`scripts/silpo_mcp_login.py`) -- `CLAUDE.md`'s own\nsession protocol requires that flow to never let an agent open a\nbrowser. This route's contract exists per plan section 1.5; making it\nactually drive the OAuth redirect is future work, not this stage's:\nno route here depends on it, and B1-B3's own criteria never exercise\nlive OAuth.",
        "operationId": "auth_start_auth_start_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Auth Start Auth Start Get"
                }
              }
            }
          }
        }
      }
    },
    "/auth/callback": {
      "get": {
        "summary": "Auth Callback",
        "operationId": "auth_callback_auth_callback_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Auth Callback Auth Callback Get"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ConsentRequest": {
        "properties": {
          "action_id": {
            "type": "string",
            "title": "Action Id"
          }
        },
        "type": "object",
        "required": [
          "action_id"
        ],
        "title": "ConsentRequest",
        "description": "D-G5-18/T18: the guest picks an `action_id` only. `args_hash` and\n`state_hash` are never accepted from the client -- the server\nrecomputes both from the proposal and cart it already holds, so a\ntampered value on the wire has nothing to overwrite."
      },
      "ConsentResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "actual_delta": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Actual Delta"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "ConsentResponse"
      },
      "CreateSessionResponse": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "trace_id": {
            "type": "string",
            "title": "Trace Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "primary_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Primary Code"
          },
          "gap": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Gap"
          },
          "candidates": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Candidates",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "trace_id",
          "status"
        ],
        "title": "CreateSessionResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}