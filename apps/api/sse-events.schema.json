{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lantern.local/schemas/sse-event.json",
  "title": "SSE event envelope",
  "description": "`event` is now the closed enum the brief declares. Corrected in place -- this description previously named a different, seven-value vocabulary (read/diagnose/plan/consent/write/readback/receipt) that was never actually emitted by any route; the five values below are what `apps/api/routes.py`'s `session_events` endpoint emits. per-event `data` shapes added for `diagnosis` and `receipt` -- previously only the three envelope fields common to every event were declared, so the disclosure layer and channel comparison the guest actually needs were never schema-checked at all. a sixth event, `stage` -- one frame per graph node the stream observed completing, `{node, io}`; an append-only log of what ran, with no index, no counters and no start signal (`stream_mode=\"updates\"` reports completions only).",
  "type": "object",
  "required": [
    "event",
    "data"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Monotonic per-session event id, for client reconnect/Last-Event-ID."
    },
    "event": {
      "type": "string",
      "enum": [
        "diagnosis",
        "options",
        "consent_required",
        "receipt",
        "error",
        "stage"
      ],
      "description": "The brief's five SSE event names, plus `stage`."
    },
    "data": {
      "type": "object",
      "description": "Every event's `data` carries session_id, trace_id, and the version tuple ; the remaining fields are specific to the event name.",
      "required": [
        "session_id",
        "trace_id",
        "version"
      ]
    },
    "retry": {
      "type": "integer",
      "minimum": 0,
      "description": "Client reconnect delay in milliseconds, per the SSE spec."
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "event": {
            "const": "diagnosis"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "required": [
              "session_id",
              "trace_id",
              "version",
              "primary_code",
              "gap",
              "gap_is_borderline",
              "validations",
              "channels",
              "products_total",
              "threshold_source",
              "cart"
            ],
            "properties": {
              "primary_code": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "gap": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "gap_is_borderline": {
                "type": "boolean"
              },
              "validations": {
                "type": "array",
                "description": "Every validation the cart already carries -- blockers and disclosures alike (the brief's disclosure-layer requirement).",
                "items": {
                  "type": "object",
                  "required": [
                    "code",
                    "level",
                    "type",
                    "is_known"
                  ],
                  "properties": {
                    "code": {
                      "type": "string"
                    },
                    "level": {
                      "type": "string",
                      "enum": [
                        "error",
                        "warning",
                        "info"
                      ]
                    },
                    "type": {
                      "type": "string"
                    },
                    "is_known": {
                      "type": "boolean",
                      "description": "whether the policy registry knows this code; a quarantined code is false."
                    }
                  }
                }
              },
              "channels": {
                "type": "array",
                "description": "The delivery-channel comparison (the delivery-channel comparison).",
                "items": {
                  "type": "object",
                  "required": [
                    "delivery_type",
                    "gap",
                    "verdict",
                    "reason"
                  ],
                  "properties": {
                    "delivery_type": {
                      "type": "string"
                    },
                    "gap": {
                      "type": "string"
                    },
                    "verdict": {
                      "type": "string",
                      "enum": [
                        "clears_now",
                        "needs_check"
                      ]
                    },
                    "reason": {
                      "type": "string"
                    }
                  }
                }
              },
              "products_total": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "the cart's productsTotal as a decimal string -- the arithmetic's input, never the cart id or coordinates."
              },
              "threshold_source": {
                "type": "string",
                "enum": [
                  "validation_context",
                  "time_slots",
                  "unverified"
                ]
              },
              "cart": {
                "type": [
                  "object",
                  "null"
                ],
                "description": "the cart as the server returned it -- lines (name, quantity, price), total, channel, slot. Never the cart id, address or coordinates.",
                "required": [
                  "delivery_type",
                  "products_total",
                  "lines"
                ],
                "properties": {
                  "delivery_type": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "timeslot_start": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "timeslot_end": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "products_total": {
                    "type": "string"
                  },
                  "lines": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "name",
                        "quantity",
                        "price"
                      ],
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "quantity": {
                          "type": "string"
                        },
                        "price": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "receipt"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "required": [
              "session_id",
              "trace_id",
              "version",
              "status",
              "reason",
              "actual_delta",
              "blocker_cleared",
              "remaining_gap",
              "expected_delta",
              "verified",
              "kind",
              "cart"
            ],
            "properties": {
              "status": {
                "type": "string"
              },
              "reason": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "actual_delta": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "blocker_cleared": {
                "type": "boolean",
                "description": "a verified write is not a recovered cart -- distinguishes 'the write landed' from 'you can check out'."
              },
              "remaining_gap": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "expected_delta": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "verified": {
                "type": "boolean"
              },
              "kind": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "add",
                  "compensate",
                  null
                ]
              },
              "cart": {
                "type": [
                  "object",
                  "null"
                ],
                "description": "the cart as the read-back saw it, projected like the diagnosis frame's; null when the read-back was unreachable.",
                "required": [
                  "delivery_type",
                  "products_total",
                  "lines"
                ],
                "properties": {
                  "delivery_type": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "timeslot_start": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "timeslot_end": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "products_total": {
                    "type": "string"
                  },
                  "lines": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "name",
                        "quantity",
                        "price"
                      ],
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "quantity": {
                          "type": "string"
                        },
                        "price": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "options"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "required": [
              "session_id",
              "trace_id",
              "version",
              "candidates"
            ],
            "properties": {
              "candidates": {
                "type": "array",
                "description": "kind distinguishes the ordinary add screen from the offer to undo a write this system already performed.",
                "items": {
                  "type": "object",
                  "required": [
                    "action_id",
                    "product_name",
                    "quantity",
                    "expected_delta",
                    "guest_text_uk",
                    "kind",
                    "compensates_action_id",
                    "args_hash",
                    "tool_name",
                    "evidence"
                  ],
                  "properties": {
                    "action_id": {
                      "type": "string"
                    },
                    "product_name": {
                      "type": "string"
                    },
                    "quantity": {
                      "type": "string"
                    },
                    "expected_delta": {
                      "type": "string"
                    },
                    "guest_text_uk": {
                      "type": "string"
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "add",
                        "compensate"
                      ]
                    },
                    "compensates_action_id": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "args_hash": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$",
                      "description": "computed at emit time with the guard's own canonicalizer."
                    },
                    "tool_name": {
                      "type": "string"
                    },
                    "evidence": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "price",
                          "availability",
                          "source_tool",
                          "captured_at"
                        ],
                        "properties": {
                          "price": {
                            "type": "string"
                          },
                          "availability": {
                            "type": "boolean"
                          },
                          "source_tool": {
                            "type": "string"
                          },
                          "captured_at": {
                            "type": "string"
                          }
                        },
                        "description": "the evidence tuple without product_id."
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event": {
            "const": "stage"
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "required": [
              "session_id",
              "trace_id",
              "version",
              "node",
              "io",
              "usage"
            ],
            "properties": {
              "node": {
                "type": "string",
                "description": "The graph node that just completed -- one of the ten names build.py registers."
              },
              "io": {
                "type": "string",
                "enum": [
                  "mcp",
                  "llm",
                  "db",
                  "pure",
                  "mcp+db"
                ],
                "description": "What kind of work the node does, from `apps/api/routes.py`'s NODE_IO -- so a loader can say MCP / model / database honestly."
              },
              "usage": {
                "type": "object",
                "description": "the session's cumulative SPEND from the provider's own usage block, priced against config/models.yaml; `ceiling_usd` is a project decision, never a remaining balance.",
                "required": [
                  "tokens",
                  "cost_usd",
                  "ceiling_usd"
                ],
                "properties": {
                  "tokens": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "cost_usd": {
                    "type": "number",
                    "minimum": 0
                  },
                  "ceiling_usd": {
                    "type": "number"
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
