# Silpo MCP OAuth (backend-only; never in the client, never in git — see IV-03)
SILPO_MCP_URL=https://mcp.silpo.ua/mcp
# Token storage: DiskTokenStorage writes here after a one-time manual login
# (reused from SupportFlow's silpo_mcp_auth.py). Never logged, never traced.
SILPO_MCP_TOKEN_PATH=.cache/silpo_mcp_token.json

# OpenRouter — LLM gateway (plan section 8.5). Key lives in backend only.
OPENROUTER_API_KEY=
OPENROUTER_DAILY_SOFT_LIMIT_USD=3
OPENROUTER_HARD_LIMIT_USD=20

# Neon Postgres (EU) — sessions, consents, receipts, idempotency keys, checkpointer
DATABASE_URL=

# LangSmith (Developer, free tier) — root trace, spans. This project's account
# uses the EU endpoint (not the US one plan section 8.2 assumed by default) —
# redaction before send stays mandatory regardless of region, PII/secrets never
# belong in a third-party trace either way (see D14).
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=lantern

# --- Caches kept inside the project, not the user's home directory ---
# A small system drive fills up fast otherwise (agentic-project-kickoff step 6)
PIP_CACHE_DIR=.cache/pip
PLAYWRIGHT_BROWSERS_PATH=.cache/playwright
