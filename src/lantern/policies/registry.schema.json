{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lantern.local/schemas/policy-registry.json",
  "title": "Policy registry",
  "description": "plan section 1.5: validation_code -> rule, source, version, test_id, confidence. Amendment A8 seeds six confirmed codes; D9 adds two quarantined ones.",
  "type": "object",
  "required": ["entries"],
  "properties": {
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "rule", "source", "version", "test_id", "confidence"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "rule": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "test_id": { "type": "string", "minLength": 1 },
          "confidence": { "type": "string", "enum": ["confirmed", "unconfirmed"] },
          "status": { "type": "string", "enum": ["active", "quarantined"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
