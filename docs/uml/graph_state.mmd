stateDiagram-v2
  [*] --> load_cart
  load_cart --> normalize
  normalize --> diagnose
  diagnose --> no_blocker : валідацій немає
  diagnose --> unknown_code : невідомий код → fail-safe
  diagnose --> collect_options
  collect_options --> propose : Evidence Gate
  collect_options --> budget_exceeded : ліміти §6.3 → terminal status
  propose --> await_consent : interrupt (human-in-the-loop)
  await_consent --> recheck : consent OK
  await_consent --> expired : TTL / відмова
  recheck --> write : state_hash збігається
  recheck --> propose : state змінився → re-plan
  write --> read_back : success
  write --> op_unknown : timeout / відповідь втрачена
  op_unknown --> read_back : журнал in_flight → перевірка постумови
  read_back --> receipt : diff = очікуваний
  read_back --> unverified : diff ≠ очікуваний або читання недоступне
  receipt --> [*]
  no_blocker --> [*]
  unknown_code --> [*]
  expired --> [*]
  unverified --> [*]
  budget_exceeded --> [*]
